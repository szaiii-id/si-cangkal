{
    "compilerOptions": {
        /* Language and Environment */
        "target": "ESNext",
        "useDefineForClassFields": true,
        "lib": ["ESNext", "DOM", "DOM.Iterable"],

        /* Modules */
        "module": "ESNext",
        "moduleResolution": "bundler",
        "paths": {
            "@/*": ["./resources/js/*"]
        },
        "types": ["vite/client", "vitest/globals", "svelte", "bun"],
        "resolveJsonModule": true,

        /* JavaScript Support */
        "allowJs": true,

        /* Emit */
        "sourceMap": true,
        "noEmit": true,

        /* Interop Constraints */
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,

        /* Type Checking — STRICT */
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,

        /* Completeness */
        "skipLibCheck": true
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.d.ts",
        "resources/js/**/*.svelte",
        "vitest-setup.ts"
    ]
}