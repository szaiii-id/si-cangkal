# ==========================================
# APPLICATION
# ==========================================
APP_NAME=SI-CANGKAL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Makassar
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ==========================================
# LOGGING
# ==========================================
LOG_CHANNEL=stack
LOG_STACK=daily,audit
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_AUDIT_DAYS=30
LOG_AUDIT_LEVEL=info

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sicangkal_db
DB_USERNAME=sicangkal_dev
DB_PASSWORD=sicangkal04!

# ==========================================
# E2E TESTING (Playwright)
# ==========================================
E2E_APP_PORT=8000
E2E_APP_URL=http://127.0.0.1:8000

E2E_DB_CONNECTION=pgsql
E2E_DB_HOST=127.0.0.1
E2E_DB_PORT=5432
E2E_DB_DATABASE=sicangkal_db_testing
E2E_DB_USERNAME=sicangkal_dev
E2E_DB_PASSWORD=sicangkal04!

# ==========================================
# SESSION, CACHE & QUEUE
# ==========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================
# MAIL (Brevo / SMTP)
# ==========================================
BREVO_API_KEY=
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sicangkal.test"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_RECIPIENT_EMAIL=

# ==========================================
# AWS S3 (Opsional)
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==========================================
# GOOGLE OAUTH
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ==========================================
# FIREBASE CLOUD MESSAGING (Push Notification)
# ==========================================
FIREBASE_CREDENTIALS=storage/app/firebase/firebase-adminsdk.json
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ==========================================
# RATE LIMITING (Gunakan 5/3 di Production)
# ==========================================
# Masa berlaku tautan verifikasi email (menit)
AUTH_VERIFICATION_EXPIRE=60

AUTH_THROTTLE_LOGIN_MAX=5
AUTH_THROTTLE_LOGIN_DECAY=60
AUTH_THROTTLE_REGISTER_MAX=3
AUTH_THROTTLE_REGISTER_DECAY=60
AUTH_THROTTLE_FORGOT_MAX=3
AUTH_THROTTLE_FORGOT_DECAY=60
AUTH_THROTTLE_RESET_MAX=5
AUTH_THROTTLE_RESET_DECAY=60
AUTH_THROTTLE_CONTACT_MAX=3
AUTH_THROTTLE_CONTACT_DECAY=60